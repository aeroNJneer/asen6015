% clear; clc;
% path = "short";
% lesserTOF = true;
% isElliptical = false;
% init;
% mu = Gsun;
% alpha = @(a,s) 2*asin(sqrt(s/(2*a)));
% beta = @(a,s,c) 2*asin(sqrt((s-c)/(2*a)));
% 
% t1 = 2460012.5;
% t2 = 2460146.5;
% dt = t2-t1
% TOF = dt*Day
% 
% R1 = [-1.451526e8;2.872782e7;1.245389e7];
% R2 = [2.454556e7;-9.611902e7;-4.480278e7];
% V1 = [-6.766088;-26.810318;-11.620955];
% V2 = [33.882657;7.872920;1.398796];
% 
% % TOF = 112*Day;
% % R1 = [1.00078e8;1.0925e8;-5.29404e3];
% % R2 = [-1.05048e8;-2.37576e7;5.73539e6];
% % V1 = [-22.4609; 20.0047; -1.799e-4];
% % V2 = [7.49784;-34.31464;-0.903];
% 
% r1 = norm(R1)
% r2 = norm(R2)
% 
% t_angle = acosd(dot(R2,R1)/(r2*r1))
% c = sqrt(r1^2+r2^2-(2*r1*r2*cosd(t_angle)))
% s = 0.5 * (r1+r2+c)
% 
% % if transfer orbit elliptical or hyperbolic?
% if (path == "short" && (TOF - TOFp_plus(Gsun,s,c)) > 0) || (path~="short" && (TOF-TOFp_minus) >0)% since desired transfer time>TOFp, elliptical
%     isElliptial = true
% else
%     exit;
% end
% a_min = s/2;
% c_min = 4*a_min-r1-r2;
% alpha_min = pi;
% beta_min = beta(a_min,s,c);
% n_min = MMfromMua(Gsun,a_min);
% 
% TOF_min = 1/n_min*((alpha_min-beta_min)-(sin(alpha_min)-sin(beta_min)))
% 
% if (TOF_min - TOF < 0)
%     lesserTOF = false;
% end
% 
% if (path == "long")
%     t_angle = 2*pi - t_angle;
% end
% 
% % part b
% % first guess
% a0 = a_min + 100;
% anext = lambert(mu,a0,s,c,t_angle,TOF,lesserTOF,path);
% [alphaf,betaf,nf] = FindVars(mu,anext,s,c,lesserTOF,path);
% % alphaf = alpha(anext,s);
% % betaf = beta(anext,s,c);
% TOFf = 1/nf*(alphaf-betaf-(sin(alphaf)-sin(betaf)));
% p = (4*anext * (s-r1)*(s-r2))/c^2 *(sin((alphaf+betaf)/2))^2;
% e = EccfromAP(anext,p);
% 
% % part d true anomaly and velocity vectors, delta v1, delta v2
% 
% TA1 = TAfromPRE(p,r1,e);
% TA2 = TAfromPRE(p,r2,e);
% 
% % use this to find velocity vectors (f & g)
% f = F(r2,p,t_angle)
%  g = G(Gsun,r2,r1,p,t_angle)
% fdot = Fdot(Gsun,r2,r1,p,t_angle)
% gdot = Gdot(r1,p,t_angle)
% 
% V1_f = (R2-f*R1)/g
% V2_i = fdot*R1 + gdot*V1_f
% deltaV1 = V1_f - V1
% deltaV2 = V2 - V2_i
% 
% deltav1 = norm(deltaV1)
% deltav2 = norm(deltaV2)

%% Problem 2
clear; clc;
init;
mu = Gsun;
path = "short";

% import data files 
opts = delimitedTextImportOptions("NumVariables", 9);

% Specify range and delimiter
opts.DataLines = [2, Inf];
opts.Delimiter = ["\t", ","];

% Specify column names and types
opts.VariableNames = ["JDTDB", "CalendarDateTDB", "X", "Y", "Z", "VX", "VY", "VZ", "VarName9"];
opts.VariableTypes = ["double", "string", "double", "double", "double", "double", "double", "double", "string"];

% Specify file level properties
opts.ExtraColumnsRule = "ignore";
opts.EmptyLineRule = "read";

% Specify variable properties
opts = setvaropts(opts, ["CalendarDateTDB", "VarName9"], "WhitespaceRule", "preserve");
opts = setvaropts(opts, ["CalendarDateTDB", "VarName9"], "EmptyFieldRule", "auto");
%filename: "/Users/nicolejames/src/asen5050/asen5050/hwk/hwk6/HW6_Ephem_Earth.txt"
% Import the data
HW6EphemEarth = readtable("HW6_Ephem_Earth.txt", opts);
HW6EphemMars = readtable("HW6_Ephem_Mars.txt", opts);

R1 = [HW6EphemEarth.X, HW6EphemEarth.Y, HW6EphemEarth.Z];
V1 = [HW6EphemEarth.VX, HW6EphemEarth.VY, HW6EphemEarth.VZ];
R2 = [HW6EphemMars.X, HW6EphemMars.Y, HW6EphemMars.Z];
V2 = [HW6EphemMars.VX, HW6EphemMars.VY, HW6EphemMars.VZ];

% create structures to store data
dvE = []; dvM = []; TOFf = [];Epochs = [];
k = 1;
for i = 1:length(R1)
    r1 = R1(i,1:3);
    v1 = V1(i,1:3);
    for j = 1:length(R2)
        TOF = (HW6EphemMars.JDTDB(j) - HW6EphemEarth.JDTDB(i))*Day;
        if TOF<0
            disp("invalid TOF");
            break;    
        end
        r2 = R2(j,1:3);
        v2 = V2(j,1:3);
        [vinfe, vinfm] = lambert2(mu,r1,r2,v1,v2,TOF,path);
        VinfE(i,j) = vinfe;
        VinfM(i,j) = vinfm;
    end
end

t = datetime(2014,6,28) + caldays(1:10);
y = rand(1,10);
plot(t,y);
xtickformat('MM-dd')

X = HW6EphemEarth.JDTDB(1:end) - HW6EphemEarth.JDTDB(1);   
Y = HW6EphemMars.JDTDB(1:end) - HW6EphemMars.JDTDB(1); 

% X = datetime(HW6EphemEarth.JDTDB,'convertfrom','juliandate')
% Y = datetime(HW6EphemMars.JDTDB,'convertfrom','juliandate')
figure(1) 
% peaks = VinfE(:); 
% peaks = fix(peaks);
peaks = [3.9 4 4.1 4.2 4.3 4.5 4.7 5 5.5 6 8 13 20 30 45 60 61 62 63];

contour(X,Y,VinfE.',peaks,'ShowText','on')
xlabel("Earth Departure (Days past 6/20/2005)")
ylabel("Mars Arrival (Days past 12/1/2005)")
title("V-infinity of Earth Departures")
colormap winter;

figure(2) 
% peaks = VinfM(:);
% peaks = fix(peaks);
peaks = [2 2.4 2.5 2.6 2.7 2.8 2.9 3 3.2 3.5 3.8 4 4.5 5 6 8 12 20 30 40 41 42  43 44];
contour(X,Y,VinfM.',peaks,'ShowText','on')
xlabel("Earth Departure (Days past 6/20/2005)")
ylabel("Mars Arrival (Days past 12/1/2005)")
title("V-infinity of Mars Arrivals")
colormap turbo;


