%General Mission Analysis Tool(GMAT) Script
%Created: 2023-09-21 01:44:12


%----------------------------------------
%---------- Spacecraft
%----------------------------------------

Create Spacecraft MAVEN;
GMAT MAVEN.DateFormat = TDBGregorian;
GMAT MAVEN.Epoch = '13 Feb 2019 00:00:00.000';
GMAT MAVEN.CoordinateSystem = MarsEq;
