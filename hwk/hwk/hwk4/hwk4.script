GMAT Spacecraft1.AttitudeCoordinateSystem = EarthMJ2000Eq;
GMAT Spacecraft1.EulerAngleSequence = '321';





%----------------------------------------
%---------- ForceModels
%----------------------------------------

Create ForceModel DefaultProp_ForceModel;
GMAT DefaultProp_ForceModel.CentralBody = Earth;
GMAT DefaultProp_ForceModel.PrimaryBodies = {Earth};
GMAT DefaultProp_ForceModel.Drag = None;
GMAT DefaultProp_ForceModel.SRP = Off;
GMAT DefaultProp_ForceModel.RelativisticCorrection = Off;
GMAT DefaultProp_ForceModel.ErrorControl = RSSStep;
GMAT DefaultProp_ForceModel.GravityField.Earth.Degree = 4;
GMAT DefaultProp_ForceModel.GravityField.Earth.Order = 4;
GMAT DefaultProp_ForceModel.GravityField.Earth.StmLimit = 100;
GMAT DefaultProp_ForceModel.GravityField.Earth.PotentialFile = 'JGM2.cof';
GMAT DefaultProp_ForceModel.GravityField.Earth.TideModel = 'None';

Create ForceModel MarsPointMass_ForceModel;
GMAT MarsPointMass_ForceModel.CentralBody = Mars;
GMAT MarsPointMass_ForceModel.PointMasses = {Mars};
GMAT MarsPointMass_ForceModel.Drag = None;
GMAT MarsPointMass_ForceModel.SRP = Off;
GMAT MarsPointMass_ForceModel.RelativisticCorrection = Off;
GMAT MarsPointMass_ForceModel.ErrorControl = RSSStep;

Create ForceModel MarsHigherGrav_ForceModel;
GMAT MarsHigherGrav_ForceModel.CentralBody = Mars;
GMAT MarsHigherGrav_ForceModel.PrimaryBodies = {Mars};
GMAT MarsHigherGrav_ForceModel.Drag = None;
GMAT MarsHigherGrav_ForceModel.SRP = Off;
GMAT MarsHigherGrav_ForceModel.RelativisticCorrection = Off;
GMAT MarsHigherGrav_ForceModel.ErrorControl = RSSStep;
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.Degree = 4;
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.Order = 4;
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.StmLimit = 100;
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.PotentialFile = 'Mars50c.cof';
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.TideModel = 'None';

Create ForceModel JupiterPointMass_ForceModel;
GMAT JupiterPointMass_ForceModel.CentralBody = Jupiter;
GMAT JupiterPointMass_ForceModel.PointMasses = {Jupiter};
GMAT JupiterPointMass_ForceModel.Drag = None;
GMAT JupiterPointMass_ForceModel.SRP = Off;
GMAT JupiterPointMass_ForceModel.RelativisticCorrection = Off;
GMAT JupiterPointMass_ForceModel.ErrorControl = RSSStep;

%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator DefaultProp;
GMAT DefaultProp.FM = DefaultProp_ForceModel;
GMAT DefaultProp.Type = RungeKutta89;
GMAT DefaultProp.InitialStepSize = 60;
GMAT DefaultProp.Accuracy = 9.999999999999999e-12;
GMAT DefaultProp.MinStep = 0.001;
GMAT DefaultProp.MaxStep = 2700;
GMAT DefaultProp.MaxStepAttempts = 50;
GMAT DefaultProp.StopIfAccuracyIsViolated = true;

Create Propagator MarsPointMass;
GMAT MarsPointMass.FM = MarsPointMass_ForceModel;
GMAT MarsPointMass.Type = RungeKutta89;
GMAT MarsPointMass.InitialStepSize = 60;
GMAT MarsPointMass.Accuracy = 9.999999999999999e-12;
GMAT MarsPointMass.MinStep = 0.001;
GMAT MarsPointMass.MaxStep = 2700;
GMAT MarsPointMass.MaxStepAttempts = 50;
GMAT MarsPointMass.StopIfAccuracyIsViolated = true;

Create Propagator MarsHigherGrav;
GMAT MarsHigherGrav.FM = MarsHigherGrav_ForceModel;
GMAT MarsHigherGrav.Type = RungeKutta89;
GMAT MarsHigherGrav.InitialStepSize = 60;
GMAT MarsHigherGrav.Accuracy = 9.999999999999999e-12;
GMAT MarsHigherGrav.MinStep = 0.001;
GMAT MarsHigherGrav.MaxStep = 2700;
GMAT MarsHigherGrav.MaxStepAttempts = 50;
GMAT MarsHigherGrav.StopIfAccuracyIsViolated = true;

Create Propagator JupiterPointMass;
GMAT JupiterPointMass.FM = JupiterPointMass_ForceModel;
GMAT JupiterPointMass.Type = RungeKutta89;
GMAT JupiterPointMass.InitialStepSize = 60;
GMAT JupiterPointMass.Accuracy = 9.999999999999999e-12;
GMAT JupiterPointMass.MinStep = 0.001;
GMAT JupiterPointMass.MaxStep = 2700;
GMAT JupiterPointMass.MaxStepAttempts = 50;
GMAT JupiterPointMass.StopIfAccuracyIsViolated = true;

%----------------------------------------
%---------- Coordinate Systems
%----------------------------------------

Create CoordinateSystem MarsEq;
GMAT MarsEq.Origin = Mars;
GMAT MarsEq.Axes = BodyInertial;

Create CoordinateSystem MarsICRF;
GMAT MarsICRF.Origin = Mars;
GMAT MarsICRF.Axes = ICRF;

Create CoordinateSystem MarsFixed;
GMAT MarsFixed.Origin = Mars;
GMAT MarsFixed.Axes = BodyFixed;

Create CoordinateSystem JupiterFixed;
GMAT JupiterFixed.Origin = Jupiter;
GMAT JupiterFixed.Axes = BodyInertial;

%----------------------------------------
%---------- Subscribers
%----------------------------------------

Create OrbitView MarsView3D;
GMAT MarsView3D.SolverIterations = Current;
GMAT MarsView3D.UpperLeft = [ 0.1858823529411765 0.06971153846153846 ];
GMAT MarsView3D.Size = [ 0.7570588235294118 0.8894230769230769 ];
GMAT MarsView3D.RelativeZOrder = 423;
GMAT MarsView3D.Maximized = false;
GMAT MarsView3D.Add = {MAVEN, Mars};
GMAT MarsView3D.CoordinateSystem = MarsEq;
GMAT MarsView3D.DrawObject = [ true true ];
GMAT MarsView3D.DataCollectFrequency = 1;
GMAT MarsView3D.UpdatePlotFrequency = 50;
GMAT MarsView3D.NumPointsToRedraw = 0;
GMAT MarsView3D.ShowPlot = true;
GMAT MarsView3D.MaxPlotPoints = 20000;
GMAT MarsView3D.ShowLabels = true;
GMAT MarsView3D.ViewPointReference = Mars;
GMAT MarsView3D.ViewPointVector = [ 30000 0 0 ];
GMAT MarsView3D.ViewDirection = Mars;
GMAT MarsView3D.ViewScaleFactor = 1;
GMAT MarsView3D.ViewUpCoordinateSystem = MarsEq;
GMAT MarsView3D.ViewUpAxis = Z;
GMAT MarsView3D.EclipticPlane = Off;
GMAT MarsView3D.XYPlane = On;
GMAT MarsView3D.WireFrame = Off;
GMAT MarsView3D.Axes = On;
GMAT MarsView3D.Grid = Off;
GMAT MarsView3D.SunLine = Off;
GMAT MarsView3D.UseInitialView = On;
GMAT MarsView3D.StarCount = 7000;
GMAT MarsView3D.EnableStars = On;
GMAT MarsView3D.EnableConstellations = Off;

Create GroundTrackPlot MarsView2D;
GMAT MarsView2D.SolverIterations = Current;
GMAT MarsView2D.UpperLeft = [ 0 0.4266826923076923 ];
GMAT MarsView2D.Size = [ 0.2170588235294118 0.4447115384615384 ];
GMAT MarsView2D.RelativeZOrder = 415;
GMAT MarsView2D.Maximized = false;
GMAT MarsView2D.Add = {MAVEN, Earth};
GMAT MarsView2D.DataCollectFrequency = 1;
GMAT MarsView2D.UpdatePlotFrequency = 50;
GMAT MarsView2D.NumPointsToRedraw = 0;
GMAT MarsView2D.ShowPlot = true;
GMAT MarsView2D.MaxPlotPoints = 20000;
GMAT MarsView2D.CentralBody = Mars;
GMAT MarsView2D.TextureMap = 'C:\Users\aussiebuttz\Downloads\gmat-win-R2022a\GMAT\data\graphics\texture\Mars_JPLCaltechUSGS.jpg';

Create XYPlot XYEcc;
GMAT XYEcc.SolverIterations = Current;
GMAT XYEcc.UpperLeft = [ 0 0 ];
GMAT XYEcc.Size = [ 0.4 0.5300480769230769 ];
GMAT XYEcc.RelativeZOrder = 393;
GMAT XYEcc.Maximized = false;
GMAT XYEcc.XVariable = MAVEN.ElapsedDays;
GMAT XYEcc.YVariables = {MAVEN.Mars.ECC};
GMAT XYEcc.ShowGrid = true;
GMAT XYEcc.ShowPlot = true;

Create XYPlot XYHmag;
GMAT XYHmag.SolverIterations = Current;
GMAT XYHmag.UpperLeft = [ 0.26 0.09134615384615384 ];
GMAT XYHmag.Size = [ 0.7152941176470589 0.7920673076923077 ];
GMAT XYHmag.RelativeZOrder = 419;
GMAT XYHmag.Maximized = false;
GMAT XYHmag.XVariable = MAVEN.ElapsedDays;
GMAT XYHmag.YVariables = {MAVEN.Mars.HMAG};
GMAT XYHmag.ShowGrid = true;
GMAT XYHmag.ShowPlot = true;

Create XYPlot XYPlot1;
GMAT XYPlot1.SolverIterations = Current;
GMAT XYPlot1.UpperLeft = [ 0.06823529411764706 0.2475961538461539 ];
GMAT XYPlot1.Size = [ 0.7082352941176471 0.6466346153846154 ];
GMAT XYPlot1.RelativeZOrder = 411;
GMAT XYPlot1.Maximized = false;
GMAT XYPlot1.XVariable = MAVEN.ElapsedDays;
GMAT XYPlot1.YVariables = {MAVEN.Mars.BetaAngle};
GMAT XYPlot1.ShowGrid = true;
GMAT XYPlot1.ShowPlot = true;


%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
Propagate 'MarsPointMass' MarsHigherGrav(MAVEN) {MAVEN.ElapsedSecs = 1577800, OrbitColor = [255 0 0]};
