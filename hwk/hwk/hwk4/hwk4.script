GMAT MAVEN.SPADSRPInterpolationMethod = Bilinear;
GMAT MAVEN.SPADSRPScaleFactorSigma = 1e+70;
GMAT MAVEN.SPADDragInterpolationMethod = Bilinear;
GMAT MAVEN.SPADDragScaleFactorSigma = 1e+70;
GMAT MAVEN.AtmosDensityScaleFactorSigma = 1e+70;
GMAT MAVEN.ModelFile = 'aura.3ds';
GMAT MAVEN.ModelOffsetX = 0;
GMAT MAVEN.ModelOffsetY = 0;
GMAT MAVEN.ModelOffsetZ = 0;
GMAT MAVEN.ModelRotationX = 0;
GMAT MAVEN.ModelRotationY = 0;
GMAT MAVEN.ModelRotationZ = 0;
GMAT MAVEN.ModelScale = 1;
GMAT MAVEN.AttitudeDisplayStateType = 'Quaternion';
GMAT MAVEN.AttitudeRateDisplayStateType = 'AngularVelocity';
GMAT MAVEN.AttitudeCoordinateSystem = EarthMJ2000Eq;
GMAT MAVEN.EulerAngleSequence = '321';

Create Spacecraft Spacecraft1;
GMAT Spacecraft1.DateFormat = TTModJulian;
GMAT Spacecraft1.Epoch = '21545.0003725';
GMAT Spacecraft1.CoordinateSystem = JupiterFixed;
GMAT Spacecraft1.DisplayStateType = Keplerian;
GMAT Spacecraft1.SMA = 3255999.999999992;
GMAT Spacecraft1.ECC = 0.9778000000000001;
GMAT Spacecraft1.INC = 96.59999999999957;
GMAT Spacecraft1.RAAN = 288.1199999999999;
GMAT Spacecraft1.AOP = 134.3;
GMAT Spacecraft1.TA = 179.5600000000001;
GMAT Spacecraft1.DryMass = 850;
GMAT Spacecraft1.Cd = 2.2;
GMAT Spacecraft1.Cr = 1.8;
GMAT Spacecraft1.DragArea = 15;
GMAT Spacecraft1.SRPArea = 1;
GMAT Spacecraft1.SPADDragScaleFactor = 1;
GMAT Spacecraft1.SPADSRPScaleFactor = 1;
GMAT Spacecraft1.AtmosDensityScaleFactor = 1;
GMAT Spacecraft1.ExtendedMassPropertiesModel = 'None';
GMAT Spacecraft1.NAIFId = -10002001;
GMAT Spacecraft1.NAIFIdReferenceFrame = -9002001;
GMAT Spacecraft1.OrbitColor = Green;
GMAT Spacecraft1.TargetColor = LightGray;
