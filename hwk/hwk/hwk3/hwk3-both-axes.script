%General Mission Analysis Tool(GMAT) Script
%Created: 2023-09-21 01:44:12


%----------------------------------------
%---------- Spacecraft
%----------------------------------------

Create Spacecraft MAVEN;
GMAT MAVEN.DateFormat = TDBGregorian;
GMAT MAVEN.Epoch = '13 Feb 2019 00:00:00.000';
GMAT MAVEN.CoordinateSystem = MarsEq;
GMAT MAVEN.DisplayStateType = Keplerian;
GMAT MAVEN.SMA = 6463.800000000046;
GMAT MAVEN.ECC = 0.4545399999998192;
GMAT MAVEN.INC = 74.92399999999888;
GMAT MAVEN.RAAN = 1.241000000001971;
GMAT MAVEN.AOP = 353.3100000000411;
GMAT MAVEN.TA = 199.3799999999806;
GMAT MAVEN.DryMass = 850;
GMAT MAVEN.Cd = 2.2;
GMAT MAVEN.Cr = 1.8;
GMAT MAVEN.DragArea = 15;
GMAT MAVEN.SRPArea = 1;
GMAT MAVEN.SPADDragScaleFactor = 1;
GMAT MAVEN.SPADSRPScaleFactor = 1;
GMAT MAVEN.AtmosDensityScaleFactor = 1;
GMAT MAVEN.ExtendedMassPropertiesModel = 'None';
GMAT MAVEN.NAIFId = -10000001;
GMAT MAVEN.NAIFIdReferenceFrame = -9000001;
GMAT MAVEN.OrbitColor = Red;
GMAT MAVEN.TargetColor = Teal;
GMAT MAVEN.OrbitErrorCovariance = [ 1e+70 0 0 0 0 0 ; 0 1e+70 0 0 0 0 ; 0 0 1e+70 0 0 0 ; 0 0 0 1e+70 0 0 ; 0 0 0 0 1e+70 0 ; 0 0 0 0 0 1e+70 ];
GMAT MAVEN.CdSigma = 1e+70;
GMAT MAVEN.CrSigma = 1e+70;
GMAT MAVEN.Id = 'SatId';
GMAT MAVEN.Attitude = CoordinateSystemFixed;
GMAT MAVEN.SPADSRPInterpolationMethod = Bilinear;
GMAT MAVEN.SPADSRPScaleFactorSigma = 1e+70;
GMAT MAVEN.SPADDragInterpolationMethod = Bilinear;
GMAT MAVEN.SPADDragScaleFactorSigma = 1e+70;
GMAT MAVEN.AtmosDensityScaleFactorSigma = 1e+70;
GMAT MAVEN.ModelFile = 'aura.3ds';
GMAT MAVEN.ModelOffsetX = 0;
GMAT MAVEN.ModelOffsetY = 0;
GMAT MAVEN.ModelOffsetZ = 0;
GMAT MAVEN.ModelRotationX = 0;
GMAT MAVEN.ModelRotationY = 0;
GMAT MAVEN.ModelRotationZ = 0;
GMAT MAVEN.ModelScale = 1;
GMAT MAVEN.AttitudeDisplayStateType = 'Quaternion';
GMAT MAVEN.AttitudeRateDisplayStateType = 'AngularVelocity';
GMAT MAVEN.AttitudeCoordinateSystem = EarthMJ2000Eq;
GMAT MAVEN.EulerAngleSequence = '321';

%----------------------------------------
%---------- Spacecraft
%----------------------------------------

Create Spacecraft MAVEN2;
GMAT MAVEN2.DateFormat = TDBGregorian;
GMAT MAVEN2.Epoch = '13 Feb 2019 00:00:00.000';
GMAT MAVEN2.CoordinateSystem = MarsICRF;
GMAT MAVEN2.DisplayStateType = Keplerian;
GMAT MAVEN2.SMA = 6463.800000007547;
GMAT MAVEN2.ECC = 0.4545399999992049;
GMAT MAVEN2.INC = 112.0290456207792;
GMAT MAVEN2.RAAN = 48.97410150113237;
GMAT MAVEN2.AOP = 354.1177616807298;
GMAT MAVEN2.TA = 199.3799999999906;
GMAT MAVEN2.DryMass = 850;
GMAT MAVEN2.Cd = 2.2;
GMAT MAVEN2.Cr = 1.8;
GMAT MAVEN2.DragArea = 15;
GMAT MAVEN2.SRPArea = 1;
GMAT MAVEN2.SPADDragScaleFactor = 1;
GMAT MAVEN2.SPADSRPScaleFactor = 1;
GMAT MAVEN2.AtmosDensityScaleFactor = 1;
GMAT MAVEN2.ExtendedMassPropertiesModel = 'None';
GMAT MAVEN2.NAIFId = -10000001;
GMAT MAVEN2.NAIFIdReferenceFrame = -9000001;
GMAT MAVEN2.OrbitColor = Red;
GMAT MAVEN2.TargetColor = Teal;
GMAT MAVEN2.OrbitErrorCovariance = [ 1e+70 0 0 0 0 0 ; 0 1e+70 0 0 0 0 ; 0 0 1e+70 0 0 0 ; 0 0 0 1e+70 0 0 ; 0 0 0 0 1e+70 0 ; 0 0 0 0 0 1e+70 ];
GMAT MAVEN2.CdSigma = 1e+70;
GMAT MAVEN2.CrSigma = 1e+70;
GMAT MAVEN2.Id = 'SatId';
GMAT MAVEN2.Attitude = CoordinateSystemFixed;
GMAT MAVEN2.SPADSRPInterpolationMethod = Bilinear;
GMAT MAVEN2.SPADSRPScaleFactorSigma = 1e+70;
GMAT MAVEN2.SPADDragInterpolationMethod = Bilinear;
GMAT MAVEN2.SPADDragScaleFactorSigma = 1e+70;
GMAT MAVEN2.AtmosDensityScaleFactorSigma = 1e+70;
GMAT MAVEN2.ModelFile = 'aura.3ds';
GMAT MAVEN2.ModelOffsetX = 0;
GMAT MAVEN2.ModelOffsetY = 0;
GMAT MAVEN2.ModelOffsetZ = 0;
GMAT MAVEN2.ModelRotationX = 0;
GMAT MAVEN2.ModelRotationY = 0;
GMAT MAVEN2.ModelRotationZ = 0;
GMAT MAVEN2.ModelScale = 1;
GMAT MAVEN2.AttitudeDisplayStateType = 'Quaternion';
GMAT MAVEN2.AttitudeRateDisplayStateType = 'AngularVelocity';
GMAT MAVEN2.AttitudeCoordinateSystem = EarthMJ2000Eq;
GMAT MAVEN2.EulerAngleSequence = '321';


%----------------------------------------
%---------- ForceModels
%----------------------------------------

Create ForceModel DefaultProp_ForceModel;
GMAT DefaultProp_ForceModel.CentralBody = Earth;
GMAT DefaultProp_ForceModel.PrimaryBodies = {Earth};
GMAT DefaultProp_ForceModel.Drag = None;
GMAT DefaultProp_ForceModel.SRP = Off;
GMAT DefaultProp_ForceModel.RelativisticCorrection = Off;
GMAT DefaultProp_ForceModel.ErrorControl = RSSStep;
GMAT DefaultProp_ForceModel.GravityField.Earth.Degree = 4;
GMAT DefaultProp_ForceModel.GravityField.Earth.Order = 4;
GMAT DefaultProp_ForceModel.GravityField.Earth.StmLimit = 100;
GMAT DefaultProp_ForceModel.GravityField.Earth.PotentialFile = 'JGM2.cof';
GMAT DefaultProp_ForceModel.GravityField.Earth.TideModel = 'None';

Create ForceModel MarsPointMass_ForceModel;
GMAT MarsPointMass_ForceModel.CentralBody = Mars;
GMAT MarsPointMass_ForceModel.PointMasses = {Mars};
GMAT MarsPointMass_ForceModel.Drag = None;
GMAT MarsPointMass_ForceModel.SRP = Off;
GMAT MarsPointMass_ForceModel.RelativisticCorrection = Off;
GMAT MarsPointMass_ForceModel.ErrorControl = RSSStep;

Create ForceModel MarsHigherGrav_ForceModel;
GMAT MarsHigherGrav_ForceModel.CentralBody = Mars;
GMAT MarsHigherGrav_ForceModel.PrimaryBodies = {Mars};
GMAT MarsHigherGrav_ForceModel.Drag = None;
GMAT MarsHigherGrav_ForceModel.SRP = Off;
GMAT MarsHigherGrav_ForceModel.RelativisticCorrection = Off;
GMAT MarsHigherGrav_ForceModel.ErrorControl = RSSStep;
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.Degree = 4;
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.Order = 4;
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.StmLimit = 100;
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.PotentialFile = 'Mars50c.cof';
GMAT MarsHigherGrav_ForceModel.GravityField.Mars.TideModel = 'None';

%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator DefaultProp;
GMAT DefaultProp.FM = DefaultProp_ForceModel;
GMAT DefaultProp.Type = RungeKutta89;
GMAT DefaultProp.InitialStepSize = 60;
GMAT DefaultProp.Accuracy = 9.999999999999999e-12;
GMAT DefaultProp.MinStep = 0.001;
GMAT DefaultProp.MaxStep = 2700;
GMAT DefaultProp.MaxStepAttempts = 50;
GMAT DefaultProp.StopIfAccuracyIsViolated = true;

Create Propagator MarsPointMass;
GMAT MarsPointMass.FM = MarsPointMass_ForceModel;
GMAT MarsPointMass.Type = RungeKutta89;
GMAT MarsPointMass.InitialStepSize = 60;
GMAT MarsPointMass.Accuracy = 9.999999999999999e-12;
GMAT MarsPointMass.MinStep = 0.001;
GMAT MarsPointMass.MaxStep = 2700;
GMAT MarsPointMass.MaxStepAttempts = 50;
GMAT MarsPointMass.StopIfAccuracyIsViolated = true;

Create Propagator MarsHigherGrav;
GMAT MarsHigherGrav.FM = MarsHigherGrav_ForceModel;
GMAT MarsHigherGrav.Type = RungeKutta89;
GMAT MarsHigherGrav.InitialStepSize = 60;
GMAT MarsHigherGrav.Accuracy = 9.999999999999999e-12;
GMAT MarsHigherGrav.MinStep = 0.001;
GMAT MarsHigherGrav.MaxStep = 2700;
GMAT MarsHigherGrav.MaxStepAttempts = 50;
GMAT MarsHigherGrav.StopIfAccuracyIsViolated = true;

%----------------------------------------
%---------- Coordinate Systems
%----------------------------------------

Create CoordinateSystem MarsEq;
GMAT MarsEq.Origin = Mars;
GMAT MarsEq.Axes = BodyInertial;

Create CoordinateSystem MarsICRF;
GMAT MarsICRF.Origin = Mars;
GMAT MarsICRF.Axes = ICRF;

%----------------------------------------
%---------- Subscribers
%----------------------------------------

Create OrbitView MarsView3D;
GMAT MarsView3D.SolverIterations = Current;
GMAT MarsView3D.UpperLeft = [ 0.3852941176470588 0.3485576923076923 ];
GMAT MarsView3D.Size = [ 0.5552941176470588 0.6189903846153846 ];
GMAT MarsView3D.RelativeZOrder = 786;
GMAT MarsView3D.Maximized = false;
GMAT MarsView3D.Add = {MAVEN, Mars};
GMAT MarsView3D.CoordinateSystem = MarsEq;
GMAT MarsView3D.DrawObject = [ true true ];
GMAT MarsView3D.DataCollectFrequency = 1;
GMAT MarsView3D.UpdatePlotFrequency = 50;
GMAT MarsView3D.NumPointsToRedraw = 0;
GMAT MarsView3D.ShowPlot = true;
GMAT MarsView3D.MaxPlotPoints = 20000;
GMAT MarsView3D.ShowLabels = true;
GMAT MarsView3D.ViewPointReference = Mars;
GMAT MarsView3D.ViewPointVector = [ 30000 0 0 ];
GMAT MarsView3D.ViewDirection = Mars;
GMAT MarsView3D.ViewScaleFactor = 1;
GMAT MarsView3D.ViewUpCoordinateSystem = MarsEq;
GMAT MarsView3D.ViewUpAxis = Z;
GMAT MarsView3D.EclipticPlane = On;
GMAT MarsView3D.XYPlane = On;
GMAT MarsView3D.WireFrame = Off;
GMAT MarsView3D.Axes = On;
GMAT MarsView3D.Grid = Off;
GMAT MarsView3D.SunLine = Off;
GMAT MarsView3D.UseInitialView = On;
GMAT MarsView3D.StarCount = 7000;
GMAT MarsView3D.EnableStars = On;
GMAT MarsView3D.EnableConstellations = Off;

Create GroundTrackPlot MarsView2D;
GMAT MarsView2D.SolverIterations = Current;
GMAT MarsView2D.UpperLeft = [ 0 0.1009615384615385 ];
GMAT MarsView2D.Size = [ 0.2170588235294118 0.7800480769230769 ];
GMAT MarsView2D.RelativeZOrder = 750;
GMAT MarsView2D.Maximized = false;
GMAT MarsView2D.Add = {MAVEN, MAVEN2};
GMAT MarsView2D.DataCollectFrequency = 1;
GMAT MarsView2D.UpdatePlotFrequency = 50;
GMAT MarsView2D.NumPointsToRedraw = 0;
GMAT MarsView2D.ShowPlot = true;
GMAT MarsView2D.MaxPlotPoints = 20000;
GMAT MarsView2D.CentralBody = Mars;
GMAT MarsView2D.TextureMap = 'C:\Users\aussiebuttz\Downloads\gmat-win-R2022a\GMAT\data\graphics\texture\Mars_JPLCaltechUSGS.jpg';

Create XYPlot XYPlot1;
GMAT XYPlot1.SolverIterations = Current;
GMAT XYPlot1.UpperLeft = [ 0.3052941176470588 0.1682692307692308 ];
GMAT XYPlot1.Size = [ 0.3164705882352941 0.4098557692307692 ];
GMAT XYPlot1.RelativeZOrder = 736;
GMAT XYPlot1.Maximized = false;
GMAT XYPlot1.XVariable = MAVEN.ElapsedDays;
GMAT XYPlot1.YVariables = {MAVEN.Mars.ECC};
GMAT XYPlot1.ShowGrid = true;
GMAT XYPlot1.ShowPlot = true;

Create XYPlot XYPlot2;
GMAT XYPlot2.SolverIterations = Current;
GMAT XYPlot2.UpperLeft = [ 0.07000000000000001 0.5324519230769231 ];
GMAT XYPlot2.Size = [ 0.2947058823529412 0.4399038461538461 ];
GMAT XYPlot2.RelativeZOrder = 746;
GMAT XYPlot2.Maximized = false;
GMAT XYPlot2.XVariable = MAVEN.ElapsedDays;
GMAT XYPlot2.YVariables = {MAVEN.Mars.HMAG};
GMAT XYPlot2.ShowGrid = true;
GMAT XYPlot2.ShowPlot = true;

%----------------------------------------
%---------- Subscribers
%----------------------------------------

Create OrbitView MarsView3D2;
GMAT MarsView3D2.SolverIterations = Current;
GMAT MarsView3D2.UpperLeft = [ 0 0.02043269230769231 ];
GMAT MarsView3D2.Size = [ 0.5552941176470588 0.6189903846153846 ];
GMAT MarsView3D2.RelativeZOrder = 796;
GMAT MarsView3D2.Maximized = false;
GMAT MarsView3D2.Add = {MAVEN2, Mars};
GMAT MarsView3D2.CoordinateSystem = MarsICRF;
GMAT MarsView3D2.DrawObject = [ true true ];
GMAT MarsView3D2.DataCollectFrequency = 1;
GMAT MarsView3D2.UpdatePlotFrequency = 50;
GMAT MarsView3D2.NumPointsToRedraw = 0;
GMAT MarsView3D2.ShowPlot = true;
GMAT MarsView3D2.MaxPlotPoints = 20000;
GMAT MarsView3D2.ShowLabels = true;
GMAT MarsView3D2.ViewPointReference = Mars;
GMAT MarsView3D2.ViewPointVector = [ 30000 0 0 ];
GMAT MarsView3D2.ViewDirection = Mars;
GMAT MarsView3D2.ViewScaleFactor = 1;
GMAT MarsView3D2.ViewUpCoordinateSystem = MarsEq;
GMAT MarsView3D2.ViewUpAxis = Z;
GMAT MarsView3D2.EclipticPlane = On;
GMAT MarsView3D2.XYPlane = On;
GMAT MarsView3D2.WireFrame = Off;
GMAT MarsView3D2.Axes = On;
GMAT MarsView3D2.Grid = Off;
GMAT MarsView3D2.SunLine = Off;
GMAT MarsView3D2.UseInitialView = On;
GMAT MarsView3D2.StarCount = 7000;
GMAT MarsView3D2.EnableStars = On;
GMAT MarsView3D2.EnableConstellations = Off;


%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
Propagate 'MarsPointMass' MarsPointMass(MAVEN) {MAVEN.ElapsedSecs = 157780, OrbitColor = [255 0 0]};
Propagate MarsPointMass(MAVEN2) {MAVEN2.ElapsedSecs = 157780, OrbitColor = [67 237 18]};
