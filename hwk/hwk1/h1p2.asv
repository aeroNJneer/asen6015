% %% Nonlinear model simulation
% t = linspace(0,40000,1000);
% pert = [0, 0, 0, dv1 ]';  % perturbation 
% X0 = X0 +  pert;                % Define initial total state
% [tout, xnl] = nlmodel(t, X0, mu, [0 0], [0 0]);
% xnl = xnl';                     % Take transpose
% 
