% plot(xnl(1,:), xnl(3,:))
% figure(7)
% generatePlots("states", tout, "Total States vs. Time, Nonlinear Dynanmics - ODE45", xnl);
% 
% % 
% % % symbolic system or numerical?
% % % if s
% % 	syms a b c d e f g h i j k
% % % else
% % % 	a = 1; b = 2; c = 3; c = 4; d = 5; e = 6; f = 7; g = 8; h = 9;
% % % 	i = 10; j = 11; k = 12;
% % % end
% % syms x1 x2 dx1 dx2 u1 u2 ddx1 ddx2
% % X = {'x1' 'x2' 'dx1' 'dx2' };
% % dX = {'dx1' 'dx2' 'ddx1' 'ddx2'};
% % U = {'u1' 'u2'};
% % 
% % % note example here has two variables with two deravitives so 
% % % two identity equations are needed to develop the state space (last two) 
% % % eq.e1 = [char(a*ddx1) '=' char(x1*dx2^2 - j/(x1^2) + e*u1)];
% % % eq.e2 = [char(f*ddx2) ' = ' char(b*dx1*dx2/x1 + h*u2)];
% % % eq.e3 = 'dx1 = dx1';
% % % eq.e4 = 'dx2 = dx2';
% % 
% % 
% % % note example here has two variables with two deravitives so 
% % % two identity equations are needed to develop the state space (last two) 
% % eq.e1 = [char(a*ddx1) ' = ' char(c*x1 + d*x2 + i*dx1 - j*dx2 + e*u1)];
% % eq.e2 = [char(f*ddx2) ' = ' char(g*x2 + b*dx1 - h*u2)];
% % eq.e3 = 'dx1 = dx1';
% % eq.e4 = 'dx2 = dx2';
% % 
% % % dy = [y(2);
% % %     dy(2)=y(1).*(y(4)^2)-(a./(y(1)^2));
% % %     dy(3)=y(4);
% % %     dy(4)=(-2.*y(2).*(y(4))./y(1));
% % eom2ss(eq,X,dX,u)
