plot3(x(1,:), x(2,:), x(3,:), DisplayName="Burn time");
hold on;
plot3(x2(1,:), x2(2,:), x2(3,:), DisplayName="Post burn coasting");
plot3(x(1,1),x(2,1),x(3,1),'o' , DisplayName="Start of burn")
