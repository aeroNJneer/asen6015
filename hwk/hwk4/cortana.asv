% Constants
mu = 398600; % Gravitational parameter for Earth (km^3/s^2)
thrust_acceleration = 30 / 1000; % Thrust acceleration (km/s^2)
tf = 23; % Initial guess for burn-out time (s)
dt = 1; % Time step (s)

% Initial state vector
r0 = [8276, 5612, 5]; % Initial position vector (km)
v0 = [-3.142, 4.672, 0]; % Initial velocity vector (km/s)
x0 = [r0, v0];

% Final orbital elements
a_final = 10000; % Semi-major axis (km)
i_final = 0; % Inclination (degrees)
e_final = 0.0001; % Eccentricity
omega_final = 35; % Argument of perigee (degrees)

% Initial guesses for steering parameters in LVLH frame
A_LVLH = [1, 0, 0]; % Example values for A
B_LVLH = [0, 0, 0]; % Example values for B

% Function to transform ECI to LVLH frame
eci_to_lvlh = @(r, v) [r/norm(r), cross(v, r)/norm(cross(v, r)), cross(cross(v, r), r)/norm(cross(cross(v, r), r))];

% Initialize position and velocity
r(:,1) = r0';
v(:,1) = v0';

% Linear Tangent Guidance Law with Costate in LVLH frame
for i = 1:dt:tf
    % Calculate the current radius
    r_mag = norm(r(:,i));
    
    % Transform velocity to LVLH frame
    T = eci_to_lvlh(r(:,i), v(:,i));
    v_LVLH = T * v(:,i);
    
    % Calculate the costate lambda_v in LVLH frame
    lambda_v_LVLH = A_LVLH + B_LVLH * t;
    
    % Calculate the required change in velocity (Delta V) using lambda_v in LVLH frame
    delta_v_LVLH = lambda_v_LVLH .* thrust_acceleration * dt;
    
    % Transform delta_v back to ECI frame
    delta_v_ECI = T' * delta_v_LVLH';
    
    % Update the velocity vector in ECI frame
    v(:,i+1) = v(:,i) + delta_v_ECI;
    
    % Predictor step: Estimate new position and velocity
    r_pred = r(:,i) + v(:,i+1) * dt;
    v_pred = v(:,i+1); % Assuming constant velocity for simplicity
    
%     % Corrector step: Iteratively correct the estimate
%     for iter = 1:5
%         r_mag_pred = norm(r_pred);
%         T_pred = eci_to_lvlh(r_pred', v_pred');
%         v_LVLH_pred = T_pred * v_pred';
%         lambda_v_LVLH_pred = A_LVLH + B_LVLH * (t + dt);
%         delta_v_LVLH_pred = lambda_v_LVLH_pred .* thrust_acceleration * dt;
%         delta_v_ECI_pred = T_pred' * delta_v_LVLH_pred';
%         v_pred = v + delta_v_ECI_pred';
%         r_pred = r + v_pred * dt;
%         
%         % Calculate the Jacobian matrix using finite differencing
%         epsilon = 1e-6; % Small perturbation for finite differencing
%         J = zeros(6, 6); % Initialize Jacobian matrix
%         
%         for i = 1:6
%             % Perturb the control vector
%             delta_u = zeros(1, 6);
%             delta_u(i) = epsilon;
%             
%             % Calculate the error vector with perturbed control
%             r_perturbed = r + (v + delta_u(4:6)) * dt;
%             v_perturbed = v + delta_u(4:6);
%             error_perturbed = [r_perturbed - r_pred, v_perturbed - v_pred];
%             
%             % Calculate the error vector without perturbation
%             error_nominal = [r_pred - r, v_pred - v];
%             
%             % Approximate the partial derivative
%             J(:, i) = (error_perturbed - error_nominal) / epsilon;
%         end
%         
%         % Update control vector using the Jacobian matrix
%         delta_u = -J \ error_nominal';
%         v_pred = v_pred + delta_u(4:6)';
%         r_pred = r_pred + v_pred * dt;
%     end
    
    % Update position and velocity with corrected values
    r(:,i+1) = r_pred;
    v(:,i+1) = v_pred';
    
    % Store or plot the results as needed
    % e.g., plot3(r(1), r(2), r(3), 'bo'); hold on;
end

% Final position and velocity
disp('Final position:');
disp(r(:,end));
disp('Final velocity:');
disp(v(:,end));
figure(1)
plot(0:1:tf,r(1,:),0:1:tf,r(2,:),0:1)