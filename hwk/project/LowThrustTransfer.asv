% Low-Thrust Orbital Transfer Simulation
% Based on Kluever 2012 "Simple Guidance Scheme for Low-Thrust Orbit Transfers"

classdef LowThrustTransfer
    properties (Constant)
        % Physical constants
        mu = 3.986e14;         % Earth's gravitational parameter (m^3/s^2)
        g0 = 9.81;             % Gravitational acceleration (m/s^2)
    end
    
    methods (Static)
        % Compute RTN to ECI transformation matrix
        function R_RTN2ECI = compute_RTN_to_ECI_matrix(r, v)
            % Radial unit vector (R direction)
            r_unit = r / norm(r);
            
            % Velocity unit vector for transverse direction
            v_unit = v / norm(v);
            
            % Normal unit vector (cross product of r and v)
            n_unit = cross(r, v) / norm(cross(r, v));
            
            % Transverse unit vector (completes right-handed system)
            t_unit = cross(n_unit, r_unit);
            
            % Transformation matrix from RTN to ECI
            R_RTN2ECI = [r_unit, t_unit, n_unit]';
        end
        
        % Compute orbital elements
        function [a, e, i, RAAN, omega, true_anomaly] = compute_orbital_elements(r, v)
            % Compute specific angular momentum
            h = cross(r, v);
            
            % Eccentricity vector
            e_vec = cross(v, h) / LowThrustTransfer.mu - r / norm(r);
            
            % Semimajor axis
            r_mag = norm(r);
            v_mag = norm(v);
            a = 1 / (2/r_mag - v_mag^2 / LowThrustTransfer.mu);
            
            % Eccentricity
            e = norm(e_vec);
            
            % Inclination
            i = acos(h(3) / norm(h));
            
            % Right ascension of ascending node
            n = cross([0; 0; 1], h);
            RAAN = atan2(n(2), n(1));
            
            % Argument of periapsis
            omega = atan2(dot(e_vec, cross(n, h)/norm(h)), dot(n, e_vec));
            
            % True anomaly
            true_anomaly = atan2(dot(cross(h, r), v), dot(h, r));
        end
        
        % Compute flight path and longitude angles
        function [flight_path_angle, longitude_angle] = compute_path_angles(r, v)
            % Flight path angle
            flight_path_angle = asin(dot(r, v) / (norm(r) * norm(v)));
            
            % Compute longitude angle
            [~, ~, ~, ~, omega, true_anomaly] = LowThrustTransfer.compute_orbital_elements(r, v);
            longitude_angle = omega + true_anomaly;
        end
        
        % Compute optimal in-plane thrust vector for semimajor axis
        function c_a = computeAxialControlVector(flight_path_angle)
            c_a = [sin(flight_path_angle); cos(flight_path_angle); 0];
        end
        
        % Compute optimal in-plane thrust vector for eccentricity
        function c_e = computeEccentricityControlVector(a, e, r, true_anomaly, flight_path_angle)
            phi_e = atan(r * sin(true_anomaly) / (2 * a * (e + cos(true_anomaly))));
            c_e = [sin(flight_path_angle + phi_e); 
                   cos(flight_path_angle + phi_e); 
                   0];
        end
        
        % Compute out-of-plane thrust steering
        function yaw = computeYawSteering(longitude_angle, Gi)
            if (abs(longitude_angle) < deg2rad(95) && abs(longitude_angle) > deg2rad(85))
                yaw = (pi/2) * cos(longitude_angle);
            else
                yaw = Gi * cos(longitude_angle);
            end
        end
        
        % Blended thrust direction computation in RTN frame
        function [thrust_unit_RTN, pitch_angle] = computeThrustDirection(c_a, c_e, Ge, Gi, flight_path_angle, longitude_angle)
            % Normalize and blend control vectors
            c_blended = Ge * c_e + c_a;
            c_blended = c_blended / norm(c_blended);
            
            % Extract pitch angle
            pitch_angle = atan2(c_blended(1), c_blended(2));
            
            % Compute thrust direction in RTN frame with yaw
            yaw = LowThrustTransfer.computeYawSteering(longitude_angle, Gi);  
            thrust_unit_RTN = [
                sin(pitch_angle) * cos(yaw);
                cos(pitch_angle) * cos(yaw);
                sin(yaw)
            ];
        end
        
        % Guidance parameter schedule
        function [Ge, Gi] = computeWeightingFunctions(t, phase_params)
            % Quadratic weighting function for eccentricity
            Ge = phase_params.Ke0 + phase_params.Ke1 * t + phase_params.Ke2 * t^2;
            
            % Linear weighting for out-of-plane steering
            Gi = phase_params.Ki0 + phase_params.Ki1 * t;
        end
        
        % Spacecraft dynamics
        function [state_dot] = spacecraft_dynamics(t, state, thrust_params, guidance_params)
            % State vector: [x, y, z, vx, vy, vz, mass]
            r = state(1:3);
            v = state(4:6);
            m = state(7);
            
            % Compute current orbital state
            [flight_path_angle, longitude_angle] = LowThrustTransfer.compute_path_angles(r, v);
            [a, e, ~, ~, ~, true_anomaly] = LowThrustTransfer.compute_orbital_elements(r, v);
            
            % Determine current phase and guidance parameters
            if t <= 120 * 24 * 3600
                phase_params = guidance_params.phase1;
            else
                phase_params = guidance_params.phase2;
            end
            
            % Compute weighting functions
            [Ge, Gi] = LowThrustTransfer.computeWeightingFunctions(t, phase_params);
            
            % Compute control vectors
            c_a = LowThrustTransfer.computeAxialControlVector(flight_path_angle);
            c_e = LowThrustTransfer.computeEccentricityControlVector(a, e, norm(r), true_anomaly, flight_path_angle);
            
            % Compute thrust direction in RTN frame
            [thrust_unit_RTN, ~] = LowThrustTransfer.computeThrustDirection(c_a, c_e, Ge, Gi, flight_path_angle, longitude_angle);
            
            % Transform thrust direction to ECI frame
            R_RTN2ECI = LowThrustTransfer.compute_RTN_to_ECI_matrix(r, v);
            thrust_unit_ECI = R_RTN2ECI' * thrust_unit_RTN;
            
            % Gravitational acceleration
            r_mag = norm(r);
            a_grav = -thrust_params.mu * r / (r_mag^3);
            
            % Thrust acceleration
            a_thrust = thrust_params.thrust_acceleration * thrust_unit_ECI / m;
            
            % Mass rate change
            mdot = -thrust_params.mass_flow_rate;
            
            % State derivative
            state_dot = [
                v;
                a_grav + a_thrust;
                mdot
            ];
        end
        
        % Main transfer simulation
        function results = simulate_transfer()
            % Initial conditions (matching paper's scenario)
            initial_altitude = 550e3;  % 550 km
            initial_inclination = 28.5 * pi/180;
            
            % Compute initial position and velocity
            r_earth = 6378e3;  % Earth radius
            r_initial = r_earth + initial_altitude;
            v_circular = sqrt(LowThrustTransfer.mu / r_initial);
            
            % Initial state
            r0 = [r_initial; 0; 0];
            v0 = [0; v_circular * cos(initial_inclination); v_circular * sin(initial_inclination)];
            
            % Target GEO conditions
            target_semimajor_axis = 42164e3;
            %  WATT = kg m^2/s^3  Isp = sec  
            % Simulation parameters
            thrust_params.power = 10e3;           % 10 kW
            thrust_params.Isp = 3300;             % Specific impulse
            thrust_params.efficiency = 0.65;      % Engine efficiency
            thrust_params.initial_mass = 1200;    % kg
            thrust_params.initial_thrust = 3.4e-5 * thrust_params.initial_mass;   % thrust to weight ratio = 3.4x10-5 
            thrust_params.mu = LowThrustTransfer.mu;
            thrust_params.thrust_acceleration = 2*thrust_params.power * thrust_params.efficiency / (thrust_params.Isp * LowThrustTransfer.g0);
            thrust_params.mass_flow_rate = 2*thrust_params.efficiency* thrust_params.power/(LowThrustTransfer.g0*thrust_params.Isp)^2; 
            
            % Phase 1 and 2 guidance parameters
            guidance_params.phase1.Ke0 = 0.0;
            guidance_params.phase1.Ke1 = -1.5e-3;
            guidance_params.phase1.Ke2 = 0.0;
            guidance_params.phase1.Ki0 = -0.33;
            guidance_params.phase1.Ki1 = -4.3e-3;
            
            guidance_params.phase2.Ke0 = -0.18;
            guidance_params.phase2.Ke1 = -1.0e-2;
            guidance_params.phase2.Ke2 = 7e-5;
            guidance_params.phase2.Ki0 = -0.85;
            guidance_params.phase2.Ki1 = -5.2e-3;
            
            % Simulation setup
            options = odeset('RelTol', 1e-8, 'AbsTol', 1e-8);
            tspan = 0:60:100*24*3600;  % Transfer time in seconds
            
            % Solve ODE
            [t, state] = ode45(@(t,y) LowThrustTransfer.spacecraft_dynamics(t, y, thrust_params, guidance_params), ...
                tspan, [r0; v0; thrust_params.initial_mass], options);
            
            % Process and return results
            results.time = t;
            results.state = state;
            
            for i = 1:length(state)
                [a(i), e(i), inc(i), ~, ~, ~] = compute_orbital_elements(state(i,1:3), state(i,4:6));
            end

            % Plot results
            figure;
            subplot(2,1,1);
            plot(t/24/3600 , vecnorm(state(:,1:3), 2, 2), 'b-');
            title('Radius vs Time');
            xlabel('Time (days)');
            ylabel('Altitude (m)');
            
            subplot(2,1,2);
            plot(t , state(:,7), 'r-');
            title('Spacecraft Mass vs Time');
            xlabel('Time (days)');
            ylabel('Mass (kg)');

            figure;
            plot3(state(:,1),state(:,2),state(:,3))
            xlabel('X')
            ylabel('Y')
            zlabel('Z')
        end
    end
end

