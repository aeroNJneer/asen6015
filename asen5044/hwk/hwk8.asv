% verify F,G,H,Q and P0 can just be constructed from blkdiag(A,B)
% lambda = blkdiag(lambda,lambda)
% zd = dt *[-Ad, lambda * blkdiag(W,W) * lambda'; zeros(8,8), Ad'];
% ZD = expm(zd);
% FD = ZD(9:16,9:16)'
% QD = FD' * ZD(1:8,9:16)

