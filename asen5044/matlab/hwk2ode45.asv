clear
k=398600
dt=10
r=6678
w=sqrt(k/(r^3))

x0=[r+10;-.5;0;w+2.5e-5]; % perturbation initial conditions

x0=[10;-.5;0;2.5e-5]; % perturbation initial conditions

tspan = linspace(0,6000,601)
opts = odeset('RelTol',1e-32,'AbsTol',1e-32);
[t,y] = ode45(@(t,y) myfunc(dt,y,k), tspan, x0, opts);

figure;
s=stackedplot(t, y);

function dy=myfunc(t,y,a)
    dy=zeros(4,1);

    dy(1)=y(2);
    dy(2)=y(1).*(y(4)^2)-(a./(y(1)^2));
    dy(3)=y(4);
    dy(4)=(-2.*y(2).*(y(4))./y(1));
end



